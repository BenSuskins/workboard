# All integrations are optional — leave unset to disable.

# Path to the SQLite database (defaults to <repo>/data/workboard.db)
# WORKBOARD_DB_PATH=./data/workboard.db

# MCP server
# WORKBOARD_MCP_PORT=8787
# Optional bearer token required on the HTTP transport
# WORKBOARD_MCP_TOKEN=

# GitHub — classic or fine-grained PAT with repo read access
# GITHUB_TOKEN=ghp_...

# Jira Cloud
# JIRA_BASE_URL=https://yourcompany.atlassian.net
# JIRA_EMAIL=you@company.com
# JIRA_API_TOKEN=...

# Google Docs (Drive read-only metadata). Run `npm run google:auth` once
# after setting these to store a refresh token in data/google-token.json.
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
